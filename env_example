# .env example file
# Copy this file to `.env` and fill in the actual values

# ----------------------------
# Django settings
# ----------------------------
SECRET_KEY=your_secret_key_here
DEBUG=False

# ----------------------------
# Database configuration
# ----------------------------
DB_ENGINE=postgresql
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# ----------------------------
# Docker DB toggle
# ----------------------------
# If true, the backend container will use the dockerized postgres service (profile: localdb).
# Default is false to use your main PostgreSQL server running on the VM.
USE_DOCKER_DB=false

# Used only when USE_DOCKER_DB=true
DOCKER_DB_NAME=mapwala_db
DOCKER_DB_USER=postgres
DOCKER_DB_PASSWORD=postgres
DOCKER_PG_HOST=db

# Used only when USE_DOCKER_DB=false and backend runs in Docker
HOST_PG_HOST=host.docker.internal

# ----------------------------
# Docker Compose override
# (uncomment when running via docker-compose)
# ----------------------------
# DATABASE_URL=postgresql://your_db_user:your_db_password@db:5432/your_db_name

# ----------------------------
# Hosts configuration
# ----------------------------
ALLOWED_HOSTS=api.example.com,admin.example.com,localhost,127.0.0.1

# ----------------------------
# CORS configuration
# ----------------------------

# For development
CORS_ALLOWED_ORIGINS=http://localhost:3000

# For production
# (uncomment and replace with real domains)
# CORS_ALLOWED_ORIGINS=https://example.com,https://admin.example.com
